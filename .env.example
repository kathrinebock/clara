# Port for the server (Railway will set this automatically)
PORT=3000

# Figma Integration (optional - for syncing tokens directly from Figma)
# Get these from:
# - File ID: https://www.figma.com/design/[FILE_ID]/...
# - Access Token: https://www.figma.com/settings/tokens
FIGMA_FILE_ID=your-figma-file-id-here
FIGMA_ACCESS_TOKEN=your-figma-access-token-here

# Optional: For authentication/API keys if you add auth later
# API_KEY=your-api-key-here
